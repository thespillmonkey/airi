{
  "id": "airi",
  "name": "AIRI Agent Mode",
  "description": "AIRI conversation channel and presentation tools",
  "channels": [
    "airi"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "clients"
    ],
    "properties": {
      "clients": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principalId",
            "agentIds"
          ],
          "properties": {
            "principalId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "tokenEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            },
            "agentIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "token": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 32,
                  "maxLength": 4096
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "provider",
                    "id"
                  ],
                  "properties": {
                    "source": {
                      "enum": [
                        "env",
                        "file",
                        "exec",
                        "store"
                      ]
                    },
                    "provider": {
                      "type": "string",
                      "minLength": 1
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "tokenFile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Absolute path to an owned private0600credential file; one hard link, no final symlink."
            }
          },
          "oneOf": [
            {
              "required": [
                "tokenEnv"
              ]
            },
            {
              "required": [
                "token"
              ]
            },
            {
              "required": [
                "tokenFile"
              ]
            }
          ]
        }
      },
      "allowedOrigins": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "channelConfigs": {
    "airi": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "contracts": {
    "tools": [
      "airi_presentation"
    ]
  },
  "toolMetadata": {
    "airi_presentation": {
      "optional": true
    }
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "clients.*.token",
          "expected": "string"
        }
      ]
    }
  },
  "uiHints": {
    "clients.*.token": {
      "label": "Client credential",
      "sensitive": true
    }
  }
}
